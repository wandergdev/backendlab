{
  "name": "backendlab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "validate": "esbuild scripts/validate.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/validate.mjs --external:sql.js --log-level=warning && node node_modules/.cache/validate.mjs"
  },
  "dependencies": {
    "motion": "^12.43.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sql.js": "^1.15.2",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
